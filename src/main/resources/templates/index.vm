<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subscription Video Links</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f5f5; padding: 20px; }
        h1 { margin-bottom: 20px; color: #333; display: flex; align-items: baseline; gap: 12px; }
        .date-range { font-size: 14px; font-weight: 400; color: #666; }
        .controls { margin-bottom: 20px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap; background: white; padding: 16px 20px; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
        .controls label { font-weight: 500; color: #444; font-size: 13px; }
        .controls select, .controls input { padding: 10px 14px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 14px; cursor: pointer; background: #fafafa; transition: border-color 0.2s, box-shadow 0.2s; min-width: 160px; }
        .controls select:hover, .controls input:hover { border-color: #bbb; }
        .controls select:focus, .controls input:focus { outline: none; border-color: #4a90d9; box-shadow: 0 0 0 3px rgba(74,144,217,0.15); background: #fff; }
        .filter-group { display: flex; align-items: center; gap: 8px; }
        .video-list { display: flex; flex-direction: column; gap: 16px; }
        .video-card { display: flex; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: transform 0.2s, border-color 0.2s; border: 2px solid transparent; }
        .video-card:hover { transform: translateY(-2px); border-color: #e53935; }
        .thumbnail { width: 240px; min-width: 240px; height: 135px; background: #000; position: relative; cursor: pointer; }
        .thumbnail img { width: 100%; height: 100%; object-fit: cover; }
        .thumbnail::after { content: '▶'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 30px; color: white; opacity: 0.8; }
        .video-info { padding: 16px; flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .video-title { font-size: 16px; font-weight: 600; color: #1a1a1a; margin-bottom: 8px; line-height: 1.4; }
        .video-channel { color: #606060; font-size: 14px; margin-bottom: 4px; }
        .video-date { color: #909090; font-size: 12px; }
    </style>
</head>
<body>
    <h1>Subscription Video Links <span class="date-range" id="dateRange"></span></h1>
    
    <div class="controls">
        <div class="filter-group">
            <label for="filterChannel">Filter by Channel:</label>
            <select id="filterChannel">
                <option value="">All Channels</option>
            </select>
        </div>
        <div class="filter-group">
            <label for="filterDate">Filter by Date (after):</label>
            <input type="date" id="filterDate">
        </div>
        <div class="filter-group">
            <label for="sort">Sort by:</label>
            <select id="sort">
                <option value="date-desc">Newest First</option>
                <option value="date-asc">Oldest First</option>
                <option value="channel-asc">Channel (A-Z)</option>
                <option value="channel-desc">Channel (Z-A)</option>
            </select>
        </div>
    </div>
    
    <div class="video-list" id="videoList"></div>

    <script>
        const videos = [
            #foreach($video in $videos)
                { thumbnail: '$video.thumbnailUrl', url: 'https://youtube.com/watch?v=$video.id', title: '$video.title', channel: '$video.channelTitle', date: '$video.getPublishedAtString' },
            #end
        ];
    </script>


    #[[
    <script>
        const videoList = document.getElementById('videoList');
        const sortSelect = document.getElementById('sort');
        const filterChannel = document.getElementById('filterChannel');
        const filterDate = document.getElementById('filterDate');

        const channels = [...new Set(videos.map(v => v.channel))].sort();
        channels.forEach(ch => {
            const opt = document.createElement('option');
            opt.value = ch;
            opt.textContent = ch;
            filterChannel.appendChild(opt);
        });

        function applyFiltersAndSort() {
            let filtered = [...videos];

            if (filterChannel.value) {
                filtered = filtered.filter(v => v.channel === filterChannel.value);
            }

            if (filterDate.value) {
                const filterDateObj = new Date(filterDate.value);
                filtered = filtered.filter(v => new Date(v.date) >= filterDateObj);
            }

            const sortCriteria = sortSelect.value;
            filtered.sort((a, b) => {
                if (sortCriteria === 'date-desc') return new Date(b.date) - new Date(a.date);
                if (sortCriteria === 'date-asc') return new Date(a.date) - new Date(b.date);
                if (sortCriteria === 'channel-asc') return a.channel.localeCompare(b.channel);
                if (sortCriteria === 'channel-desc') return b.channel.localeCompare(a.channel);
            });

            renderVideos(filtered);
            updateDateRange(filtered);
        }

        function updateDateRange(data) {
            if (data.length === 0) {
                document.getElementById('dateRange').textContent = '';
                return;
            }
            const dates = data.map(v => new Date(v.date)).sort((a, b) => a - b);
            const start = dates[0].toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            const end = dates[dates.length - 1].toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            document.getElementById('dateRange').textContent = `(${start} - ${end})`;
        }

        function renderVideos(data) {
            if (data.length === 0) {
                videoList.innerHTML = '<p style="color: #666; text-align: center; padding: 20px;">No videos match your filters.</p>';
                return;
            }
            videoList.innerHTML = data.map(v => `
                <div class="video-card">
                    <a href="${v.url}" target="_blank" class="thumbnail"><img src="${v.thumbnail}" alt="${v.title}"></a>
                    <div class="video-info">
                        <div class="video-title">${v.title}</div>
                        <div class="video-channel">${v.channel}</div>
                        <div class="video-date">${new Date(v.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
                    </div>
                </div>
            `).join('');
        }

        filterChannel.addEventListener('change', applyFiltersAndSort);
        filterDate.addEventListener('change', applyFiltersAndSort);
        sortSelect.addEventListener('change', applyFiltersAndSort);
        applyFiltersAndSort();
    </script>
    ]]#
</body>
</html>